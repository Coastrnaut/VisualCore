      "owner": "VisualCoreShaderSource + VisualCoreRendering"
    },
    {
      "area": "Effects",
      "description": "Versioned effect-graph description, validator (≤ 32 passes, memory quota) and GPU executor with 8 pass types; EffectScene wraps any scene and adds the Reduce Flashing limiter.",
      "paths": [
        "Packages/VisualCore/Sources/VisualCoreEffectsGraph/EffectGraph.swift",
        "Packages/VisualCoreRendering/Sources/VisualCoreEffects/EffectScene.swift"
      ],
      "owner": "VisualCoreEffectsGraph + VisualCoreEffects"
    },
    {
      "area": "Scenes, input, simulation",
