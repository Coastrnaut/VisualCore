      ],
      "owner": "VisualCoreRendering (ADR-0002 seam)"
    },
    {
      "area": "Resources and budgets",
      "description": "ResourceRegistry creates textures, buffers, render targets and programs under a ResourceBudget, pools render targets, caches programs, counts leaks and rejects stale handles after a generation change.",
      "paths": [
        "Packages/VisualCoreRendering/Sources/VisualCoreRendering/ResourceRegistry.swift",
        "Packages/VisualCoreRendering/Sources/VisualCoreRendering/GPUObjects.swift",
        "Packages/VisualCore/Sources/VisualCoreDiagnostics/ResourceLedger.swift"
      ],
      "owner": "VisualCoreRendering + VisualCoreDiagnostics"
