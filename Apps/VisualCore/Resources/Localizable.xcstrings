    "vc.settings.quality.note": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatic starts at the best quality and steps down while the device is hot or in Low Power Mode, then back up when it has cooled. A number keeps that level; 0 is the best. An experience with fewer levels uses its last one."
          }
        }
      }
    },
