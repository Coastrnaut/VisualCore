        ],
        "standardName": "Articulatio genus",
        "synonyms": []
      },
      {
        "description": "The thigh bone runs down from the hip and widens at its lower end into two rounded knobs called condyles. These knobs rest on the top of the shin bone and form the upper half of the knee. A smooth groove at the front between them guides the kneecap.",
        "englishName": "Femur",
        "id": "knee.femur",
        "layer": "bones",
