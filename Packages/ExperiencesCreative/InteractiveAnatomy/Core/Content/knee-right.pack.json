    "structures": [
      {
        "description": "The knee joint links the thigh bone to the shin bone, with the kneecap at its front. Cartilage pads, ligaments and tendons hold its bones together while letting the leg bend and straighten.",
        "englishName": "Knee joint",
        "id": "knee.joint",
