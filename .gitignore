# --- VisualCore additions (ADR-0001) ---
# Claude Code machine-local settings
.claude/settings.local.json
# Apple / Swift build output: generated, never committed
Build/
*.xcodeproj/
*.xcworkspace/
DerivedData/
.build/
.swiftpm/
xcuserdata/
__pycache__/
*.pyc
# Generated by XcodeGen
Apps/*/Info.plist
Showcase/Info.plist
# Owner-only signing (never committed)
Configs/Signing.local.xcconfig
# Autonomy ledger: state.json, evidence/ and checks/ are tracked; bulky or private outputs are not
.autonomy/context/
.autonomy/logs/
.autonomy/xcresults/
.autonomy/reports/
.autonomy/private/
.autonomy/desktop.lock/

# Harness Info.plists generated by XcodeGen (feature 006)
Harnesses/*/Generated/
